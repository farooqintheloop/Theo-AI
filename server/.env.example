NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173,https://theo-ai-ivory.vercel.app

# Current local development cluster is HeadStart. Switch to theo-ai-db later.
# Never commit the real password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@headstart.8hoopao.mongodb.net/?retryWrites=true&w=majority&appName=theo-ai
MONGODB_DB_NAME=theo

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
